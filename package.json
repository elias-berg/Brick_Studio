{
  "name": "brick-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "catalog:refresh": "node scripts/refresh-catalog.mjs && npm run thumbnails:generate",
    "predev": "npm run thumbnails:generate",
    "prebuild": "npm run thumbnails:generate",
    "thumbnails:generate": "tsx scripts/generate-thumbnails.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:types": "tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
