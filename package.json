    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
